    "An agent counts while it works, not while it waits for you." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Agent zählt, solange er arbeitet, nicht während er auf dich wartet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un agente cuenta mientras trabaja, no mientras te espera."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un agent compte tant qu’il travaille, pas quand il vous attend."
          }
        }
      }
    },
    "Applies on battery, and with the lid closed also on a charger that doesn't charge. Now at %@." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gilt im Batteriebetrieb und bei geschlossenem Deckel auch an einem Netzteil, das nicht lädt. Aktuell %@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se aplica con batería y, con la tapa cerrada, también con un cargador que no carga. Ahora al %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S’applique sur batterie et, écran rabattu, aussi sur un chargeur qui ne charge pas. Actuellement à %@."
          }
        }
      }
    },
    "Applies on battery. This Mac has none." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gilt im Batteriebetrieb. Dieser Mac hat keine Batterie."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se aplica con batería. Este Mac no tiene batería."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S’applique sur batterie. Ce Mac n’en a pas."
          }
        }
      }
    },
    "Applies when macOS reports high temperatures, sooner with the lid closed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gilt, wenn macOS hohe Temperaturen meldet, bei geschlossenem Deckel früher."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se aplica cuando macOS informa de temperaturas altas, antes con la tapa cerrada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S’applique quand macOS signale des températures élevées, plus tôt écran rabattu."
          }
        }
      }
    },
