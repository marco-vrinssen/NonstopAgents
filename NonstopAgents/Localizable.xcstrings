    "Welcome to Nonstop Agents" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Willkommen bei Nonstop Agents"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te damos la bienvenida a Nonstop Agents"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bienvenue dans Nonstop Agents"
          }
        }
      }
    },
    "When agents finish while you are away" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn Agenten fertig sind, während du weg bist"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando los agentes terminen mientras no estás"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quand les agents terminent pendant votre absence"
          }
        }
      }
    },
    "When agents finish while you're away, or your Mac pauses for battery or heat. macOS asks you once." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn Agenten fertig sind, während du weg bist, oder dein Mac wegen Batterie oder Hitze pausiert. macOS fragt dich einmal."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando los agentes terminen mientras no estás o tu Mac se pause por la batería o el calor. macOS te lo pregunta una vez."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quand les agents terminent pendant votre absence, ou quand votre Mac se met en pause à cause de la batterie ou de la chaleur. macOS vous le demande une fois."
          }
        }
      }
    },
    "When pausing for battery" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei einer Pause wegen der Batterie"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al pausar por la batería"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En cas de pause liée à la batterie"
          }
        }
      }
    },
    "When reaching high temperatures" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei hohen Temperaturen"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al alcanzar temperaturas altas"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "À haute température"
          }
        }
      }
    },
    "With lid closed" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit geschlossenem Deckel"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con la tapa cerrada"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Écran rabattu"
          }
        }
      }
    },
    "Your Mac can sleep now." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Mac kann jetzt in den Ruhezustand wechseln."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu Mac ya puede entrar en reposo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre Mac peut maintenant suspendre son activité."
          }
        }
      }
    },
    "Your Mac is hot. It can sleep now." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Mac ist heiß. Er kann jetzt in den Ruhezustand wechseln."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu Mac está caliente. Ya puede entrar en reposo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre Mac est chaud. Il peut maintenant suspendre son activité."
          }
        }
      }
    },
    "Your Mac is unplugged. It can sleep now." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Mac ist nicht am Netzteil. Er kann jetzt in den Ruhezustand wechseln."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu Mac está desconectado. Ya puede entrar en reposo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre Mac est débranché. Il peut maintenant suspendre son activité."
          }
        }
      }
    },
    "Your Mac stays awake while AI agents work, so they run nonstop. When the last one finishes, your Mac sleeps as usual." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Mac bleibt wach, solange KI-Agenten arbeiten, damit sie ohne Pause laufen. Ist der letzte fertig, wechselt dein Mac wie gewohnt in den Ruhezustand."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu Mac sigue activo mientras trabajan los agentes de IA, para que funcionen sin parar. Cuando termina el último, tu Mac entra en reposo como siempre."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre Mac reste éveillé pendant que les agents IA travaillent, pour qu’ils tournent sans interruption. Quand le dernier a terminé, votre Mac suspend son activité comme d’habitude."
          }
        }
      }
    },
    "Your Mac still sleeps on low battery or when it runs hot. It stays awake with the lid closed only if you choose that in the menu." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei niedrigem Batteriestand oder Hitze wechselt dein Mac trotzdem in den Ruhezustand. Bei geschlossenem Deckel bleibt er nur wach, wenn du das im Menü auswählst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu Mac sigue entrando en reposo con poca batería o cuando se calienta. Solo sigue activo con la tapa cerrada si lo eliges en el menú."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre Mac suspend quand même son activité quand la batterie est faible ou qu’il chauffe. Il ne reste éveillé écran rabattu que si vous le choisissez dans le menu."
          }
        }
      }
    },
