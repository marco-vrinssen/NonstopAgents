            "value" : "Jusqu’à une heure…"
          }
        }
      }
    },
    "Update installs when your Mac may sleep" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Update wird installiert, sobald dein Mac ruhen darf"
          }
