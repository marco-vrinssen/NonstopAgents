    "Choose the .claude folder in your home folder so Nonstop Agents can read what Claude Code is working on. Access is read-only." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle den Ordner „.claude“ in deinem Benutzerordner, damit Nonstop Agents lesen kann, woran Claude Code arbeitet. Der Zugriff ist nur lesend."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige la carpeta .claude de tu carpeta de inicio para que Nonstop Agents pueda leer en qué trabaja Claude Code. El acceso es de solo lectura."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez le dossier .claude dans votre dossier de départ pour que Nonstop Agents puisse lire sur quoi travaille Claude Code. L’accès est en lecture seule."
          }
        }
      }
    },
    "Choose “Update to %@…” in the menu to install it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle „Auf %@ aktualisieren …“ im Menü, um es zu installieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige «Actualizar a %@…» en el menú para instalarla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez « Mettre à jour vers %@… » dans le menu pour l’installer."
          }
        }
      }
    },
