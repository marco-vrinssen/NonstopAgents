    "Copies the app and macOS versions, the Mac model, the power state and the names of the detected tools, without titles or folders. Paste them into the issue." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopiert die Versionen der App und von macOS, das Mac-Modell, den Energiestatus und die Namen der erkannten Tools, ohne Titel oder Ordner. Füge sie in den Bericht ein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copia las versiones de la app y de macOS, el modelo de Mac, el estado de energía y los nombres de las herramientas detectadas, sin títulos ni carpetas. Pégalos en el informe."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copie les versions de l’app et de macOS, le modèle de Mac, l’état de l’alimentation et les noms des outils détectés, sans titres ni dossiers. Collez-les dans le rapport."
          }
        }
      }
    },
    "Copy" : {
