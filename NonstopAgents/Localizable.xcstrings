    "Add any command line tool by its process name. It counts while it works." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge ein beliebiges Befehlszeilenwerkzeug über seinen Prozessnamen hinzu. Es zählt, solange es arbeitet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade cualquier herramienta de línea de comandos por su nombre de proceso. Cuenta mientras trabaja."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez n’importe quel outil en ligne de commande par son nom de processus. Il compte tant qu’il travaille."
          }
        }
      }
    },
