    },
    "Nonstop Agents asks GitHub once a day. Updates install the next time it quits or your Mac restarts, never while it keeps your Mac awake. This is version %@." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nonstop Agents fragt einmal am Tag bei GitHub nach. Updates werden installiert, wenn die App das nächste Mal beendet wird oder dein Mac neu startet, nie während sie deinen Mac wach hält. Dies ist Version %@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nonstop Agents consulta GitHub una vez al día. Las actualizaciones se instalan la próxima vez que se cierre la app o se reinicie tu Mac, nunca mientras mantiene tu Mac activo. Esta es la versión %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nonstop Agents consulte GitHub une fois par jour. Les mises à jour s’installent la prochaine fois que l’app quitte ou que votre Mac redémarre, jamais pendant qu’elle garde votre Mac éveillé. Ceci est la version %@."
          }
        }
      }
    },
