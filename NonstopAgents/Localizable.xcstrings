    "An agent counts while it works, not while it waits for you." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Agent zählt, solange er arbeitet, nicht während er auf dich wartet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un agente cuenta mientras trabaja, no mientras te espera."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un agent compte tant qu’il travaille, pas quand il vous attend."
          }
        }
      }
    },
    "Applies on battery, also with the lid closed. Now at %@." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gilt im Batteriebetrieb, auch bei geschlossenem Deckel. Aktuell %@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se aplica con batería, también con la tapa cerrada. Ahora al %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S’applique sur batterie, aussi écran rabattu. Actuellement à %@."
